# Public (exposed to the browser) — required if Lovable Cloud is enabled
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only — used by SSR / server functions
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the nitro build target. Defaults to "vercel".
# NITRO_PRESET=vercel
